// Central Barline product identity and supported platform.
BARLINE_PRODUCT_NAME = Barline
BARLINE_APP_BUNDLE_IDENTIFIER = com.mabryventures.Barline
BARLINE_MENU_SERVICE_BUNDLE_IDENTIFIER = com.mabryventures.Barline.MenuBarService
BARLINE_INTENTS_BUNDLE_IDENTIFIER = com.mabryventures.Barline.Intents
BARLINE_APP_GROUP_IDENTIFIER = group.com.mabryventures.Barline
BARLINE_LOGGING_SUBSYSTEM = com.mabryventures.Barline
BARLINE_DEVELOPMENT_TEAM =
BARLINE_SPARKLE_FEED_URL =
BARLINE_SPARKLE_PUBLIC_KEY =

ARCHS = arm64
EXCLUDED_ARCHS = x86_64 i386
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
DEVELOPMENT_TEAM = $(BARLINE_DEVELOPMENT_TEAM)
INFOPLIST_KEY_NSHumanReadableCopyright = Copyright © 2026 Mabry Ventures LLC and Barline contributors
